  "dailyRotation": {
    "_meta": "Documents the deterministic daily/weekly rotation quest.rs already implements, so a back-office editor can reason about it. Model = every player sees the SAME cadence, but each player's rolled jobs are seeded by (characterId, resetBoundary, poolId, slot) so boards differ per player yet are stable within a reset window and reproducible on re-fetch. Change the cadence by editing jobPools[].recurrence + globals; change difficulty by editing perTypeDifficulty.",
    "resetModel": {
      "dailyResetHourUtc": 5,
      "dailyResetMinuteUtc": 0,
      "weeklyResetDayOfWeek": 1,
      "_note": "UESP + JobData: Normal + Daily jobs refresh every 24h at 05:00 UTC; the Weekly job refreshes Monday 05:00 UTC. quest.rs derives the reset boundary from globals.dailyJobsRefreshTimeHour/Minute (05:00) and rolls the weekly pool on its recurrence.dayOfWeek."
    },
    "boardComposition": {
      "regularSlots": 4,
      "dailyFeatured": 1,
      "weeklyBoss": 1,
      "_note": "Authoritative: globals.maxActiveJobs = 4 Standard slots. quest.rs adds 1 weekly Duel boss always, plus the per-weekday featured Daily pool that is active on its window (one job). Typical board = 4 + 1 boss + (0..1 featured) = 5-6 jobs."
    },
    "seeding": {
      "scheme": "deterministic",
      "seedInputs": [
        "characterId",
        "resetBoundary(epochSecs)",
        "jobPoolId",
        "slotIndex"
      ],
      "prng": "splitmix64 (self-contained in quest.rs jobs_gen)",
      "_note": "IMPLEMENTATION CHOICE (not from the client): guarantees same board within a reset window, different board per character, reproducible on every /quests fetch without persisting job bodies."
    },
    "autoEasing": {
      "_guessed": true,
      "enabled": false,
      "failuresBeforeEase": 3,
      "difficultyStepDown": 1,
      "_note": "UESP: after several unfinishable jobs the game eases difficulty. NOT yet implemented in quest.rs. A faithful impl would track a per-character difficultyBias (persisted on the character), subtract it in roll_difficulty, and increment it on repeated abandon/fail. Wire this before relying on it."
    }
  },
